# End-to-end (Playwright) test settings. Copy to .env and adjust; .env is not committed.
#
# Each target is one Foundry install + one data folder (with its dnd5e version).
# Tests never write to the data folder: they run on a throwaway copy of the world.

# Targets to test, in order. `npm run test:e2e` uses FOUNDRY_TARGET, or the first one;
# `npm run test:e2e:all` runs every target in turn.
FOUNDRY_TARGETS=v13_dnd5e4,v14_dnd5e6

# Per target: the Foundry install folder (contains main.js) and the data folder (contains Config/ and Data/)
FOUNDRY_v13_dnd5e4_CODE=C:\path\to\Foundry\v13\code
FOUNDRY_v13_dnd5e4_DATA=C:\path\to\Foundry\v13\data4

FOUNDRY_v14_dnd5e6_CODE=C:\path\to\Foundry\v14\code
FOUNDRY_v14_dnd5e6_DATA=C:\path\to\Foundry\v14\data6
# Optional: module ids to leave out for this target, comma separated (e.g. not yet compatible)
FOUNDRY_v14_dnd5e6_DISABLE_MODULES=midi-qol

# The world to test in, and the users to log in as
FOUNDRY_WORLD=testing
FOUNDRY_GM_USER=Gamemaster
FOUNDRY_GM_PASSWORD=
FOUNDRY_PLAYER_USER=Player
FOUNDRY_PLAYER_PASSWORD=

# Port for the test server (pick one your own Foundry instances don't use)
FOUNDRY_PORT=30199

# Browser: an installed channel (msedge, chrome), so Playwright needs no browser download
FOUNDRY_BROWSER_CHANNEL=msedge

# Optional: where the throwaway data folders go (default: the system temp folder)
# FOUNDRY_WORK_DIR=
